{
  "hosts": [
    { "name": "babel", "inference": true },
    { "name": "waka", "inference": true }
  ],
  "projects": [
    { "name": "comfy-room", "path": "~aidan/Projects/comfy-room" },
    { "name": "pebble", "path": "~aidan/Projects/pebble" },
    { "name": "discordfs", "path": "~aidan/Projects/discordfs" }
  ],
  "configRepos": [
    { "name": "dotfiles", "path": "~aidan/.dotfiles", "workTree": "~aidan" },
    { "name": "nixos", "path": "/etc/nixos", "nixos": true }
  ],
  "llamaService": "llama-cpp.service",
  "llamaUserService": false,
  "gpuSysfsPath": "/sys/class/drm",
  "procPath": "/proc",
  "diskPaths": ["/", "~aidan"],
  "staleRepoDays": 30,
  "llamaUrl": "http://127.0.0.1:8080",
  "zellijCachePath": "~/.cache/zellij"
}
